---
export interface Props {
  bookNumber: number
  title: string
  hadithCount: number
  chapterCount: number
  subtitle?: string
  href?: string
  theme?: "emerald" | "burgundy" | "navy" | "gold"
}

const {
  bookNumber,
  title,
  hadithCount,
  chapterCount,
  subtitle = "شرح موطأ الإمام مالك",
  href,
  theme = "emerald",
} = Astro.props

const num = (n: number | null | undefined) =>
  n == null ? "" : n.toLocaleString("ar-MA", { useGrouping: false })

const targetUrl = href || `/diwan#book-${bookNumber}`
---

<a href={targetUrl} class={`book-card-link theme-${theme}`}>
  <article class='book-card'>
    <div class='border-frame'></div>
    <div class='corner top-right'></div>
    <div class='corner top-left'></div>
    <div class='corner bottom-right'></div>
    <div class='corner bottom-left'></div>

    <div class='header-tag'>الكتاب {num(bookNumber)}</div>

    <div class='center-content'>
      <div class='star-emblem' aria-hidden='true'>
        <div class='star-shape star-1'></div>
        <div class='star-shape star-2'></div>
        <div class='star-core'></div>
      </div>
      <h3 class='book-title'>{title}</h3>
      <p class='book-subtitle'>{subtitle}</p>
    </div>

    <footer class='card-footer'>
      <span class='meta-badge'>{num(hadithCount)} حديث</span>
      <span class='meta-dot'>•</span>
      <span class='meta-badge'>{num(chapterCount)} باب</span>
    </footer>
  </article>
</a>

<style>
  .book-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 6px 14px 14px 6px;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s ease;
  }

  .book-card-link:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.35);
  }

  .book-card-link:focus-visible {
    outline: 2px solid var(--accent, #d4af37);
    outline-offset: 4px;
  }

  /* Core Card Layout */
  .book-card {
    position: relative;
    aspect-ratio: 1 / 1.45;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    border-radius: 6px 14px 14px 6px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    user-select: none;
  }

  /* Themes */
  .theme-emerald .book-card {
    background: radial-gradient(
      circle at center,
      #1b3a32 0%,
      #0d1f1a 80%,
      #06100d 100%
    );
  }
  .theme-burgundy .book-card {
    background: radial-gradient(
      circle at center,
      #4a121a 0%,
      #29080e 80%,
      #120306 100%
    );
  }
  .theme-navy .book-card {
    background: radial-gradient(
      circle at center,
      #1e293b 0%,
      #0f172a 80%,
      #020617 100%
    );
  }
  .theme-gold .book-card {
    background: radial-gradient(
      circle at center,
      #3d2e14 0%,
      #241a0a 80%,
      #120c04 100%
    );
  }

  /* Spine Simulation */
  .book-card::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 16px;
    height: 100%;
    background: rgba(0, 0, 0, 0.35);
    border-left: 2px solid rgba(212, 175, 55, 0.25);
  }

  /* Islamic Double Border */
  .border-frame {
    position: absolute;
    top: 10px;
    right: 22px;
    left: 10px;
    bottom: 10px;
    border: 2px solid #d4af37;
    border-radius: 2px;
    pointer-events: none;
  }

  .border-frame::after {
    content: "";
    position: absolute;
    top: 4px;
    right: 4px;
    left: 4px;
    bottom: 4px;
    border: 1px dashed rgba(212, 175, 55, 0.4);
  }

  /* Corners */
  .corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #d4af37;
    border-style: solid;
    pointer-events: none;
    z-index: 2;
  }

  .top-right {
    top: 14px;
    right: 26px;
    border-width: 2px 2px 0 0;
  }
  .top-left {
    top: 14px;
    left: 14px;
    border-width: 2px 0 0 2px;
  }
  .bottom-right {
    bottom: 14px;
    right: 26px;
    border-width: 0 2px 2px 0;
  }
  .bottom-left {
    bottom: 14px;
    left: 14px;
    border-width: 0 0 2px 2px;
  }

  /* Content Styling */
  .header-tag {
    font-size: 0.78rem;
    color: #e2c775;
    z-index: 1;
    font-weight: 600;
  }

  .center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
    width: 100%;
  }

  /* Geometric Star Emblem */
  .star-emblem {
    width: 42px;
    height: 42px;
    position: relative;
    margin-bottom: 0.75rem;
  }

  .star-shape {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 1.5px solid #d4af37;
  }

  .star-1 {
    transform: rotate(0deg);
  }
  .star-2 {
    transform: rotate(45deg);
  }

  .star-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    background: #d4af37;
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  .book-title {
    font-family: "Amiri", "Reem Kufi", serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  .book-subtitle {
    font-size: 0.8rem;
    color: #d4af37;
    margin-top: 0.35rem;
    opacity: 0.9;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: #a8c2b5;
    z-index: 1;
  }

  .meta-dot {
    color: #d4af37;
  }
</style>
