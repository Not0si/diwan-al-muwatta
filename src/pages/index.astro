---
import BaseLayout from "../components/base-layout.astro"
import BookCard from "../components/BookCard.astro"
import { getDiwanBooks } from "../generators/diwan-books"
import { getTimeline } from "../generators/timeline"

const timeline = await getTimeline()
const books = await getDiwanBooks(timeline)

const totalBooks = books.length
const num = (n: number | null | undefined) =>
  n == null ? "" : n.toLocaleString("ar-MA", { useGrouping: false })

const featuredBooks = books.slice(0, 4)
const themeCycle = ["emerald", "burgundy", "navy", "gold"] as const
---

<BaseLayout title='كرسي الإمام مالك — الصفحة الرئيسية'>
  <style>
    /* Feature & Layout CSS retained from your setup */
    .hero {
      position: relative;
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 1.5rem 3rem;
      text-align: center;
      overflow: hidden;
    }

    .hero-kicker {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: var(--accent);
      background: var(--accent-tint);
      padding: 0.4rem 1rem;
      border-radius: 999px;
      margin-bottom: 1.25rem;
    }

    .hero h1 {
      font-family: "Amiri", serif;
      font-size: clamp(2rem, 5.5vw, 3.25rem);
      font-weight: 700;
      line-height: 1.15;
      margin: 0 0 1.25rem;
      color: var(--ink);
    }

    .hero h1 em {
      font-style: normal;
      color: var(--accent);
    }

    .hero p {
      max-width: 40rem;
      margin: 0 auto 2rem;
      font-size: 1.05rem;
      color: var(--ink-soft);
      line-height: 1.9;
    }

    /* ---------- Books Showcase Grid ---------- */
    .section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section-head {
      margin-bottom: 2rem;
    }

    .section-head h2 {
      font-family: "Amiri", serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      margin: 0 0 0.4rem;
      color: var(--ink);
    }

    .section-head p {
      margin: 0;
      color: var(--ink-soft);
    }

    .books-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .books-more {
      text-align: center;
      margin-top: 1rem;
    }

    .btn {
      font: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      cursor: pointer;
    }

    .btn-ghost {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--ink);
    }
  </style>

  <!-- Hero Section -->
  <section class='hero'>
    <span class='hero-kicker'>شرح موطأ الإمام مالك</span>
    <h1>
      كرسي <em>الإمام مالك</em>
    </h1>
    <p>
      سلسلة دروس علمية في شرح موطأ الإمام مالك رحمه الله، مرتّبة وموثّقة حسب
      الكتب والأبواب، مع فهرس شامل وجدول زمني يسهّل الوصول إلى كل درس.
    </p>
  </section>

  <!-- Books Showcase Section -->
  <section class='section'>
    <div class='section-head'>
      <h2>نظرة على دِيوَانُ المُوَطَّأِ لِلإِمَامِ مَالِك</h2>
      <p>اختر كتاباً لتصفح أبوابه وأحاديثه الموثقة</p>
    </div>

    <div class='books-grid'>
      {featuredBooks.map((book, idx) => (
        <BookCard
          bookNumber={book.book_number}
          title={book.title}
          hadithCount={book.hadith_count}
          chapterCount={book.chapters.length}
          theme={themeCycle[idx % themeCycle.length]}
        />
      ))}
    </div>

    <div class='books-more'>
      <a class='btn btn-ghost' href='/diwan'>
        عرض الفهرس الكامل ({num(totalBooks)} كتاب)
      </a>
    </div>
  </section>
</BaseLayout>
